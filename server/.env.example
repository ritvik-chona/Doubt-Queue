MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doubt-queue?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
# Set to production on Render (enables Secure + SameSite=None cookies)
NODE_ENV=development

# Optional: only if local DNS refuses the Atlas SRV lookup (querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1
